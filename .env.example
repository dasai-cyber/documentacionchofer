# ========================================================
# VARIABLES DE ENTORNO — FICHA CONDUCTORES DASAI
# ========================================================

# 1. Base de Datos y Storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui

# 2. Correo de Destino (Donde quieres recibir las fichas)
ADMIN_EMAIL=contacto@dasai.cl

# 3. Proveedor de Envíos de Correo (Elige Opción A o B):

# Opción A: Resend (Recomendado para Vercel - Gratis hasta 3.000 correos/mes)
# Obtén tu clave en https://resend.com
RESEND_API_KEY=re_123456789
EMAIL_FROM="Dasai Logística <onboarding@resend.dev>"

# Opción B: SMTP Tradicional (Gmail, Google Workspace, Outlook, CPanel)
# Para Gmail, genera una "Contraseña de Aplicación" en https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contrasena_de_aplicacion_16_digitos
