EMAIL_FROM="Dasai Logística <onboarding@resend.dev>"

# Opción B: SMTP Tradicional (Gmail, Google Workspace, Outlook, CPanel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contrasena_de_aplicacion_16_digitos

# 4. Integración Automática con Google Drive (Opcional)
